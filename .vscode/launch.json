{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Repo Ghost Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-ext"],
      "outFiles": ["${workspaceFolder}/packages/vscode-ext/dist/**/*.js"],
      "preLaunchTask": "repo-ghost: build"
    }
  ]
}
